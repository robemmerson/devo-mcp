{
 "_comment": "Sweep recipes for `devo.py activity <term> --by user|ip|host`, for Devo's standard tables. Each source has `by` (which sweep), `table`, `filter` ({T} is replaced with the quoted term), optional `pre` (a select clause run before grouping, e.g. peek() on Message), either `group` (grouped with count/first/last, re-aggregated across chunks) or `select`, optional `chunk`/`parallel`, `accounts` (fields shown under 'entities seen'; when absent, any value containing the term), optional `actor` and `target` (the fields `timeline` puts in those slots, in preference order; `actor` defaults to `accounts` for user sweeps, so set it when `accounts` also lists a target field), and `note`. These are hints, not facts about your domain: on first use the helper keeps only the sources whose table exists in the domain and whose fields are in the table's live schema, adds generated sources for other tables with user/IP/host fields, and caches the result (`devo.py cache status`).",
 "sources": [
  {
   "by": "user",
   "name": "onepassword_audit",
   "table": "auth.agilebits.onepassword.audit",
   "filter": "weakhas(actor_details__email, {T}) or weakhas(aux_details__email, {T})",
   "group": "actor_details__email, aux_details__email, action, object_type, session__ip",
   "accounts": [
    "actor_details__email",
    "aux_details__email"
   ],
   "actor": [
    "actor_details__email"
   ],
   "target": [
    "aux_details__email"
   ],
   "note": "dlgsess/ssotknv rows are session plumbing; the rest are admin/item changes"
  },
  {
   "by": "user",
   "name": "onepassword_items",
   "table": "auth.agilebits.onepassword.itemusage",
   "filter": "weakhas(user__email, {T})",
   "group": "user__email, action, vault_uuid, item_uuid, client__app_name, client__platform_name, client__ip_address",
   "accounts": [
    "user__email"
   ],
   "note": "item/vault are uuids only (no names)"
  },
  {
   "name": "onepassword_signin",
   "table": "auth.agilebits.onepassword.signinattempt",
   "filter": "weakhas(target_user__email, {T})",
   "select": "*",
   "accounts": [
    "target_user__email"
   ],
   "note": "client__platform_name = device hostname",
   "by": "user"
  },
  {
   "by": "user",
   "name": "linux",
   "table": "box.unix",
   "filter": "appName in {\"sshd\", \"sshd-session\", \"sudo\", \"su\", \"systemd-logind\"}, weakhas(message, {T})",
   "group": "machine, appName",
   "chunk": "3h",
   "parallel": 8
  },
  {
   "by": "user",
   "name": "windows_powershell_4103",
   "table": "box.win_nxlog.powershell",
   "filter": "EventID = 4103, weakhas(ContextInfo, {T})",
   "group": "host, EventID",
   "chunk": "3h",
   "parallel": 6,
   "note": "4103 ContextInfo has 'User = DOMAIN\\\\user' and 'Host Application = <command line>'; 4104 has no parsed user (only rawMessage AccountName)"
  },
  {
   "by": "user",
   "name": "windows_powershell_4104_account",
   "table": "box.win_nxlog.powershell",
   "filter": "EventID = 4104, weakhas(rawMessage, {T})",
   "group": "host, Path",
   "chunk": "3h",
   "parallel": 6,
   "note": "matches the AccountName/Domain kept only in rawMessage, but also any script text containing the term",
   "attribution": "raw-text"
  },
  {
   "by": "user",
   "name": "windows_security",
   "table": "box.win_nxlog.security",
   "filter": "weakhas(TargetUserName, {T}) or weakhas(SubjectUserName, {T})",
   "group": "EventID, host, TargetUserName, SubjectUserName, LogonType, WorkstationName, src",
   "chunk": "1h",
   "parallel": 5,
   "accounts": [
    "TargetUserName",
    "SubjectUserName"
   ],
   "pre": "peek(Message, re(\"Source Network Address:\\\\s*([^\\\\r\\\\n\\\\t]+)\"), 1) as src",
   "note": "src = the client address from Message (Source Network Address); IpAddress may be the reporting host"
  },
  {
   "name": "windows_sysmon",
   "table": "box.win_nxlog.sysmon",
   "filter": "weakhas(User, {T})",
   "group": "host, User, EventID, Image",
   "chunk": "3h",
   "parallel": 6,
   "accounts": [
    "User"
   ],
   "by": "user"
  },
  {
   "by": "user",
   "name": "aws_cloudtrail",
   "table": "cloud.aws.cloudtrail.cloudtrail",
   "filter": "weakhas(userIdentity_arn, {T})",
   "group": "ACCID, userIdentity_arn, eventName, sourceIPAddress",
   "accounts": [
    "userIdentity_arn"
   ],
   "note": "SSO users appear as assumed-role/AWSReservedSSO_<permission set>_<hash>/<upn>"
  },
  {
   "by": "user",
   "name": "aws_ec2",
   "table": "cloud.aws.cloudtrail.ec2",
   "filter": "weakhas(userIdentity_arn, {T})",
   "group": "ACCID, userIdentity_arn, eventName, sourceIPAddress, errorCode",
   "accounts": [
    "userIdentity_arn"
   ],
   "note": "SSO users appear as assumed-role/AWSReservedSSO_<permission set>_<hash>/<upn>"
  },
  {
   "name": "aws_iam",
   "table": "cloud.aws.cloudtrail.iam",
   "filter": "weakhas(userIdentity_arn, {T})",
   "group": "userIdentity_arn, eventName, sourceIPAddress, errorCode",
   "accounts": [
    "userIdentity_arn"
   ],
   "by": "user"
  },
  {
   "by": "user",
   "name": "aws_kms",
   "table": "cloud.aws.cloudtrail.kms",
   "filter": "weakhas(userIdentity_arn, {T})",
   "group": "ACCID, userIdentity_arn, eventName, sourceIPAddress, errorCode",
   "accounts": [
    "userIdentity_arn"
   ],
   "note": "SSO users appear as assumed-role/AWSReservedSSO_<permission set>_<hash>/<upn>"
  },
  {
   "by": "user",
   "name": "aws_lambda",
   "table": "cloud.aws.cloudtrail.lambda",
   "filter": "weakhas(userIdentity_arn, {T})",
   "group": "ACCID, userIdentity_arn, eventName, sourceIPAddress, errorCode",
   "accounts": [
    "userIdentity_arn"
   ],
   "note": "SSO users appear as assumed-role/AWSReservedSSO_<permission set>_<hash>/<upn>"
  },
  {
   "by": "user",
   "name": "aws_organizations",
   "table": "cloud.aws.cloudtrail.organizations",
   "filter": "weakhas(userIdentity_arn, {T})",
   "group": "ACCID, userIdentity_arn, eventName, sourceIPAddress",
   "accounts": [
    "userIdentity_arn"
   ],
   "note": "SSO users appear as assumed-role/AWSReservedSSO_<permission set>_<hash>/<upn>"
  },
  {
   "by": "user",
   "name": "aws_s3",
   "table": "cloud.aws.cloudtrail.s3",
   "filter": "weakhas(userIdentity_arn, {T})",
   "group": "ACCID, userIdentity_arn, eventName, sourceIPAddress, errorCode",
   "accounts": [
    "userIdentity_arn"
   ],
   "chunk": "1d"
  },
  {
   "by": "user",
   "name": "aws_secretsmanager",
   "table": "cloud.aws.cloudtrail.secretsmanager",
   "filter": "weakhas(userIdentity__arn, {T})",
   "group": "ACCID, userIdentity__arn, eventName, sourceIPAddress_str",
   "accounts": [
    "userIdentity__arn"
   ],
   "note": "this table uses userIdentity__arn (double underscore) and sourceIPAddress_str"
  },
  {
   "by": "user",
   "name": "aws_signin",
   "table": "cloud.aws.cloudtrail.signin",
   "filter": "weakhas(userIdentity_arn, {T}) or weakhas(rawMessage, {T})",
   "group": "ACCID, userIdentity_type, userIdentity_arn, eventName, responseElements_ConsoleLogin, sourceIPAddress",
   "accounts": [
    "userIdentity_arn"
   ]
  },
  {
   "by": "user",
   "name": "aws_sts",
   "table": "cloud.aws.cloudtrail.sts",
   "filter": "weakhas(userIdentity_arn, {T}) or weakhas(requestParameters_roleSessionName, {T})",
   "group": "ACCID, userIdentity_type, userIdentity_arn, eventName, requestParameters_roleArn, requestParameters_roleSessionName, sourceIPAddress",
   "accounts": [
    "userIdentity_arn",
    "requestParameters_roleSessionName"
   ]
  },
  {
   "name": "entra_audit",
   "table": "cloud.azure.ad.audit",
   "filter": "weakhas(properties_initiatedBy_user_userPrincipalName, {T})",
   "select": "eventdate, operationName, tenantId, properties_loggedByService, properties_result, properties_initiatedBy_user_userPrincipalName, target_upn, target_name",
   "accounts": [
    "properties_initiatedBy_user_userPrincipalName"
   ],
   "actor": [
    "properties_initiatedBy_user_userPrincipalName",
    "properties_initiatedBy_app_displayName"
   ],
   "target": [
    "target_upn",
    "target_name"
   ],
   "by": "user",
   "pre": "str(jqeval(jqcompile(\".[0].userPrincipalName\"), properties_targetResources)) as target_upn, str(jqeval(jqcompile(\".[0].displayName\"), properties_targetResources)) as target_name",
   "note": "target_upn/target_name = the first target (a #EXT# UPN is a B2B guest)"
  },
  {
   "by": "user",
   "name": "entra_audit_target",
   "table": "cloud.azure.ad.audit",
   "filter": "weakhas(stringify(properties_targetResources), {T})",
   "group": "operationName, properties_loggedByService, properties_initiatedBy_user_userPrincipalName, properties_initiatedBy_app_displayName",
   "accounts": [
    "properties_initiatedBy_user_userPrincipalName"
   ],
   "actor": [
    "properties_initiatedBy_user_userPrincipalName",
    "properties_initiatedBy_app_displayName"
   ],
   "note": "where two collectors feed this table, count rows with tenantId set (the other copy is a duplicate)",
   "attribution": "target"
  },
  {
   "by": "user",
   "name": "entra_noninteractive",
   "table": "cloud.azure.ad.noninteractive_user_signin",
   "filter": "weakhas(properties_userPrincipalName, {T})",
   "group": "properties_userPrincipalName, properties_userId, properties_ipAddress, properties_location_countryOrRegion, properties_appDisplayName, properties_status_errorCode",
   "chunk": "3h",
   "parallel": 6,
   "accounts": [
    "properties_userPrincipalName"
   ],
   "attribution": "automated"
  },
  {
   "by": "user",
   "name": "entra_provisioning",
   "table": "cloud.azure.ad.provisioning",
   "filter": "isnotnull(properties_id), weakhas(sourceIdentityDetailsUserPrincipalName, {T})",
   "group": "sourceIdentityDetailsUserPrincipalName, properties_servicePrincipal_Name, provisioningAction, provisioningStepsStatus",
   "accounts": [
    "sourceIdentityDetailsUserPrincipalName"
   ]
  },
  {
   "by": "user",
   "name": "entra_interactive",
   "table": "cloud.azure.ad.signin",
   "filter": "weakhas(properties_userPrincipalName, {T})",
   "group": "properties_userPrincipalName, properties_userId, properties_ipAddress, properties_location_countryOrRegion, properties_appDisplayName, properties_clientAppUsed, properties_status_errorCode, properties_deviceDetail_displayName",
   "accounts": [
    "properties_userPrincipalName"
   ]
  },
  {
   "by": "user",
   "name": "entra_risk",
   "table": "cloud.azure.ad.user_risk_events",
   "filter": "weakhas(properties__userPrincipalName, {T})",
   "group": "properties__userPrincipalName, properties__riskEventType, properties__riskLevel, properties__riskState, properties__ipAddress",
   "accounts": [
    "properties__userPrincipalName"
   ],
   "note": "Identity Protection detections; properties__requestId = sign-in properties_id"
  },
  {
   "by": "user",
   "name": "defender_logged_on",
   "table": "cloud.azure.ah.device_info",
   "filter": "weakhas(logged_on_users, {T})",
   "group": "device_name, os_platform, public_ip",
   "accounts": []
  },
  {
   "by": "user",
   "name": "defender_logons",
   "table": "cloud.azure.ah.device_logon_event",
   "filter": "weakhas(account_name, {T})",
   "group": "device_name, account_domain, account_name, action_type, logon_type, remote_ip",
   "accounts": [
    "account_name"
   ]
  },
  {
   "by": "user",
   "name": "defender_network",
   "table": "cloud.azure.ah.device_network_event",
   "filter": "weakhas(init_process_account_name, {T}), action_type = \"ConnectionSuccess\"",
   "group": "device_name, init_process_account_name, init_process_file_name, remote_url, remote_port",
   "chunk": "6h",
   "parallel": 4,
   "accounts": [
    "init_process_account_name"
   ]
  },
  {
   "by": "user",
   "name": "defender_processes",
   "table": "cloud.azure.ah.device_process_event",
   "filter": "weakhas(account_name, {T}) or weakhas(account_upn, {T})",
   "group": "device_name, account_domain, account_name, account_upn, file_name",
   "chunk": "6h",
   "parallel": 4,
   "accounts": [
    "account_name",
    "account_upn"
   ]
  },
  {
   "by": "user",
   "name": "entra_gsa",
   "table": "cloud.azure.others.events",
   "filter": "category in {\"NetworkAccessTrafficLogs\", \"NetworkAccessConnectionEvents\"}, weakhas(stringify(properties), {T})",
   "select": "eventdate, category, jqeval(jqcompile(\".UserPrincipalName\"), properties) as upn, jqeval(jqcompile(\".ClientDeviceName\"), properties) as device, jqeval(jqcompile(\".SourceIp\"), properties) as src, jqeval(jqcompile(\".DestinationFQDN\"), properties) as dest",
   "chunk": "1d",
   "parallel": 8
  },
  {
   "name": "o365_azureactivedirectory",
   "table": "cloud.office365.management.azureactivedirectory",
   "filter": "weakhas(UserId, {T})",
   "group": "UserId, Operation, ClientIP",
   "accounts": [
    "UserId"
   ],
   "by": "user"
  },
  {
   "name": "o365_copilot",
   "table": "cloud.office365.management.copilot",
   "filter": "weakhas(UserId, {T})",
   "group": "UserId, Operation, ClientIP",
   "accounts": [
    "UserId"
   ],
   "by": "user"
  },
  {
   "by": "user",
   "name": "o365_exchange",
   "table": "cloud.office365.management.exchange",
   "filter": "weakhas(UserId, {T}) or weakhas(MailboxOwnerUPN, {T})",
   "group": "UserId, MailboxOwnerUPN, Operation, ClientIPAddress",
   "accounts": [
    "UserId",
    "MailboxOwnerUPN"
   ],
   "actor": [
    "UserId"
   ],
   "target": [
    "MailboxOwnerUPN"
   ]
  },
  {
   "name": "o365_microsoft365group",
   "table": "cloud.office365.management.microsoft365group",
   "filter": "weakhas(UserId, {T})",
   "group": "UserId, Operation",
   "accounts": [
    "UserId"
   ],
   "note": "no ClientIP in this table",
   "by": "user"
  },
  {
   "name": "o365_microsoftforms",
   "table": "cloud.office365.management.microsoftforms",
   "filter": "weakhas(UserId, {T})",
   "group": "UserId, Operation, ClientIP",
   "accounts": [
    "UserId"
   ],
   "by": "user"
  },
  {
   "name": "o365_microsoftteams",
   "table": "cloud.office365.management.microsoftteams",
   "filter": "weakhas(UserId, {T})",
   "group": "UserId, Operation, ClientIP",
   "accounts": [
    "UserId"
   ],
   "by": "user"
  },
  {
   "by": "user",
   "name": "o365_teams_meetings_attended",
   "table": "cloud.office365.management.microsoftteams",
   "filter": "Operation = \"MeetingParticipantDetail\", weakhas(message, {T})",
   "select": "eventdate, UserId, ClientIP, ItemName, str(jqeval(jqcompile(\".Attendees[0].UPN\"), jsonparse(message))) as attendee, str(jsonparse(message)[\"JoinTime\"]) as joined, str(jsonparse(message)[\"LeaveTime\"]) as left_at",
   "accounts": [
    "attendee"
   ],
   "note": "UserId on these rows is the meeting ORGANIZER; the person is Attendees[0]. The o365_microsoftteams sweep misses meetings a person only attended."
  },
  {
   "by": "user",
   "name": "o365_microsofttodo_by_oid",
   "table": "cloud.office365.management.microsofttodo",
   "filter": "UserId = {T}",
   "group": "UserId, Operation",
   "accounts": [
    "UserId"
   ],
   "note": "UserId is the Entra object id (never a UPN): run with the object id from --graph-ids, a surname never matches. Applies to planner app rows too."
  },
  {
   "by": "user",
   "name": "o365_onedrive",
   "table": "cloud.office365.management.onedrive",
   "filter": "weakhas(UserId, {T})",
   "group": "UserId, Operation, ClientIP, SourceFileName, TargetUserOrGroupName, TargetUserOrGroupType",
   "accounts": [
    "UserId"
   ],
   "note": "same batch-driven lag and duplication as sharepoint.; sharing operations name the recipient (TargetUserOrGroupName/Type: Guest = outside the tenant)"
  },
  {
   "name": "o365_planner",
   "table": "cloud.office365.management.planner",
   "filter": "weakhas(UserId, {T})",
   "group": "UserId, Operation, ClientIP",
   "accounts": [
    "UserId"
   ],
   "by": "user"
  },
  {
   "name": "o365_powerbi",
   "table": "cloud.office365.management.powerbi",
   "filter": "weakhas(UserId, {T})",
   "group": "UserId, Operation, ClientIP",
   "accounts": [
    "UserId"
   ],
   "by": "user"
  },
  {
   "by": "user",
   "name": "o365_powerplatform",
   "table": "cloud.office365.management.powerplatform",
   "filter": "weakhas(UserId, {T})",
   "select": "eventdate, UserId, ResultStatus, str(jsonparse(rawMessage)[\"Operation\"]) as operation",
   "accounts": [
    "UserId"
   ]
  },
  {
   "name": "o365_securitycompliancecenter",
   "table": "cloud.office365.management.securitycompliancecenter",
   "filter": "weakhas(UserId, {T})",
   "group": "UserId, Operation, ClientIP",
   "accounts": [
    "UserId"
   ],
   "by": "user"
  },
  {
   "by": "user",
   "name": "o365_sharepoint",
   "table": "cloud.office365.management.sharepoint",
   "filter": "weakhas(UserId, {T})",
   "group": "UserId, Operation, ClientIP, SourceFileName, TargetUserOrGroupName, TargetUserOrGroupType",
   "accounts": [
    "UserId"
   ],
   "note": "sharing operations name the recipient (TargetUserOrGroupName/Type: Guest = outside the tenant)"
  },
  {
   "by": "user",
   "name": "o365_threatintelligence",
   "table": "cloud.office365.management.threatintelligence",
   "filter": "weakhas(Recipients, {T}) or weakhas(P1Sender, {T}) or weakhas(P2Sender, {T})",
   "group": "Operation, Verdict, DeliveryAction, P2Sender",
   "accounts": [
    "Recipients",
    "P2Sender"
   ],
   "actor": [
    "P2Sender"
   ],
   "target": [
    "Recipients"
   ]
  },
  {
   "name": "o365_yammer",
   "table": "cloud.office365.management.yammer",
   "filter": "weakhas(UserId, {T})",
   "group": "UserId, Operation, ClientIP",
   "accounts": [
    "UserId"
   ],
   "by": "user"
  },
  {
   "by": "user",
   "name": "devo_alert_actions",
   "table": "devo.audit.alert.triggered",
   "filter": "weakhas(username, {T})",
   "group": "username, action, name",
   "accounts": [
    "username"
   ],
   "note": "who changed status/commented on Devo alerts"
  },
  {
   "name": "sentinelone_mgmt",
   "table": "edr.sentinelone.management.activities",
   "filter": "weakhas(dataUsername, {T}) or weakhas(dataActoralternateid, {T}) or weakhas(dataLoginsusername, {T}) or weakhas(dataSourceprocessusername, {T})",
   "select": "*",
   "accounts": [
    "dataUsername",
    "dataActoralternateid",
    "dataLoginsusername",
    "dataSourceprocessusername"
   ],
   "by": "user"
  },
  {
   "by": "user",
   "name": "fortinet_admin",
   "table": "firewall.fortinet.event.system",
   "filter": "weakhas(user, {T})",
   "group": "devName, user, ui, logdesc, action, status",
   "accounts": [
    "user"
   ]
  },
  {
   "by": "user",
   "name": "fortinet_unauthuser",
   "table": "firewall.fortinet.traffic.forward",
   "filter": "weakhas(unauthuser, {T})",
   "group": "devName, unauthuser, unauthusersource, srcIp",
   "chunk": "3h",
   "parallel": 8,
   "accounts": [
    "unauthuser"
   ]
  },
  {
   "name": "devo_alerts",
   "table": "siem.logtrust.alert.info",
   "filter": "weakhas(username, {T}) or weakhas(extraData, {T})",
   "select": "eventdate, alertId, context, username, extraData",
   "accounts": [
    "username"
   ],
   "by": "user"
  },
  {
   "by": "user",
   "name": "devo_web",
   "table": "siem.logtrust.web.navigation",
   "filter": "weakhas(userEmail, {T})",
   "group": "userEmail, srcHost, section, action",
   "accounts": [
    "userEmail"
   ],
   "note": "Devo console use"
  },
  {
   "name": "github_enterprise",
   "table": "vcs.github.enterprise.audit",
   "filter": "weakhas(actor, {T}) or weakhas(user, {T}) or weakhas(external_identity_username, {T})",
   "group": "actor, user, external_identity_username, action, actor_ipv4, actor_location__country_code",
   "accounts": [
    "actor",
    "user",
    "external_identity_username"
   ],
   "actor": [
    "actor",
    "external_identity_username"
   ],
   "target": [
    "user"
   ],
   "by": "user"
  },
  {
   "name": "github_org",
   "table": "vcs.github.organization.audit",
   "filter": "weakhas(actor, {T}) or weakhas(external_identity_username, {T})",
