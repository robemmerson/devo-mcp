    "Username"
   ],
   "by": "user"
  },
  {
   "by": "user",
   "name": "qualys_users",
   "table": "vuln.qualys.useractivitylog",
   "filter": "weakhas(user_name, {T})",
   "group": "user_name, user_role, module, action, user_ip",
   "accounts": [
    "user_name"
   ]
  },
  {
   "by": "ip",
   "name": "onepassword_audit_ip",
   "table": "auth.agilebits.onepassword.audit",
   "filter": "session__ip = {T}",
   "group": "actor_details__email, action, object_type"
  },
  {
   "by": "ip",
   "name": "onepassword_items_ip",
   "table": "auth.agilebits.onepassword.itemusage",
   "filter": "client__ip_address = {T}",
   "group": "user__email, action, client__app_name, client__platform_name"
  },
  {
   "by": "ip",
   "name": "onepassword_signin_ip",
   "table": "auth.agilebits.onepassword.signinattempt",
   "filter": "client__ip_address = {T}",
   "group": "target_user__email, category, client__app_name, client__platform_name"
  },
  {
   "by": "ip",
   "name": "linux_ssh_ip",
   "table": "box.unix",
   "filter": "appName in {\"sshd\", \"sshd-session\", \"sudo\", \"su\"}, message -> {T}",
   "group": "machine, appName",
   "chunk": "6h"
  },
  {
   "by": "ip",
   "name": "win_security_msg_ip",
   "table": "box.win_nxlog.security",
   "filter": "weakhas(Message, {T})",
   "group": "EventID, host, TargetUserName, SubjectUserName, LogonType",
   "chunk": "1h",
   "parallel": 6,
   "note": "the event's own client/source IP is in Message (Source Network Address / Client Address / Source Address); IpAddress may be the reporting host's own IP where the NxLog config sets it"
  },
  {
   "by": "ip",
   "name": "sysmon_dns_answer_ip",
   "table": "box.win_nxlog.sysmon",
   "filter": "EventID = 22, weakhas(Message, {T})",
   "group": "host, Image",
   "chunk": "3h",
   "parallel": 6,
   "note": "hosts whose DNS answers contained the IP (QueryResults lists ::ffff:<ip>;). Add peek(Message, re(\"QueryName:\\\\s*([^\\\\r\\\\n]+)\"), 1) for the name"
  },
  {
   "by": "ip",
   "name": "sysmon_net_ip",
   "table": "box.win_nxlog.sysmon",
   "filter": "EventID = 3, DestinationIp = {T} or SourceIp = {T}",
   "group": "host, User, Image, SourceIp, DestinationIp, DestinationPort, Initiated",
   "chunk": "3h",
   "parallel": 6
  },
  {
   "by": "ip",
   "name": "win_host_by_ip",
   "table": "box.win_nxlog.system",
   "filter": "IpAddress = {T}",
   "group": "host, IpAddress",
   "note": "answers 'which Windows host is this IP' only where the NxLog config writes the reporting host's own IP into IpAddress: check a few rows first"
  },
  {
   "by": "ip",
   "name": "aws_ec2_ip",
   "table": "cloud.aws.cloudtrail.ec2",
   "filter": "sourceIPAddress = {T}",
   "group": "ACCID, userIdentity_arn, eventName, errorCode"
  },
  {
   "by": "ip",
   "name": "aws_signin_ip",
   "table": "cloud.aws.cloudtrail.signin",
   "filter": "sourceIPAddress = {T}",
   "group": "ACCID, userIdentity_type, userIdentity_arn, eventName, responseElements_ConsoleLogin"
  },
  {
   "by": "ip",
   "name": "aws_sts_ip",
   "table": "cloud.aws.cloudtrail.sts",
   "filter": "sourceIPAddress = {T}",
   "group": "ACCID, userIdentity_type, userIdentity_arn, eventName, requestParameters_roleSessionName"
  },
  {
   "by": "ip",
   "name": "entra_audit_ip",
   "table": "cloud.azure.ad.audit",
   "filter": "properties_initiatedBy_user_ipAddress = {T}",
   "group": "properties_initiatedBy_user_userPrincipalName, operationName",
   "note": "often a Microsoft service IP rather than the user's own; where two collectors feed this table, count rows with tenantId set (the other copy is a duplicate)"
  },
  {
   "by": "ip",
   "name": "graph_ip",
   "table": "cloud.azure.ad.microsoft_graph_activity_logs",
   "filter": "properties__ip_address_str = {T}",
   "group": "properties__user_id, properties__app_id, properties__service_principal_id, properties__request_method",
   "chunk": "2h",
   "parallel": 8
  },
  {
   "by": "ip",
   "name": "entra_noninteractive_ip",
   "table": "cloud.azure.ad.noninteractive_user_signin",
   "filter": "properties_ipAddress = {T}",
   "group": "properties_userPrincipalName, properties_appDisplayName, properties_status_errorCode",
   "chunk": "3h",
   "parallel": 6
  },
  {
   "by": "ip",
   "name": "entra_sp_ip",
   "table": "cloud.azure.ad.service_principal_signin",
   "filter": "properties_ipAddress = {T}",
   "group": "properties_servicePrincipalName, properties_appId, properties_status_errorCode"
  },
  {
   "by": "ip",
   "name": "entra_signin_ip",
   "table": "cloud.azure.ad.signin",
   "filter": "properties_ipAddress = {T}",
   "group": "properties_userPrincipalName, properties_appDisplayName, properties_status_errorCode"
  },
  {
   "by": "ip",
   "name": "entra_signin_all",
   "table": "cloud.azure.ad.signin_all",
   "filter": "source_ip = {T}",
   "group": "source, username, error_code"
  },
  {
   "by": "ip",
   "name": "entra_risk_ip",
   "table": "cloud.azure.ad.user_risk_events",
   "filter": "properties__ipAddress = {T}",
   "group": "properties__userPrincipalName, properties__riskEventType"
  },
  {
   "by": "ip",
   "name": "defender_ip_egress",
   "table": "cloud.azure.ah.device_info",
   "filter": "public_ip = {T}",
   "group": "device_name, os_platform",
   "note": "devices whose egress public IP this is"
  },
  {
   "by": "ip",
   "name": "defender_ip_local",
   "table": "cloud.azure.ah.device_network_event",
   "filter": "local_ip = {T}",
   "group": "device_name, init_process_account_name",
   "chunk": "6h",
   "parallel": 4,
   "note": "which device/user held this internal IP"
  },
  {
   "by": "ip",
   "name": "defender_ip_remote",
   "table": "cloud.azure.ah.device_network_event",
   "filter": "remote_ip = {T}",
   "group": "device_name, init_process_file_name, remote_port, remote_url, action_type",
   "chunk": "6h",
   "parallel": 4
  },
  {
   "by": "ip",
   "name": "defender_ip_owner",
   "table": "cloud.azure.ah.device_network_info",
   "filter": "weakhas(ip_addresses, {T})",
   "group": "device_name, device_id, network_adapter_status",
   "note": "internal IP -> device. A bare term also matches longer IPs (10.1.2.3 in 10.1.2.30); confirm in ip_addresses or search with the JSON quotes \"\\\"10.1.2.3\\\"\""
  },
  {
   "by": "ip",
   "name": "o365_aad_ip",
   "table": "cloud.office365.management.azureactivedirectory",
   "filter": "ClientIP -> {T}",
   "group": "UserId, Operation, ResultStatus",
   "accounts": [
    "UserId"
   ]
  },
  {
   "by": "ip",
   "name": "o365_copilot_ip",
   "table": "cloud.office365.management.copilot",
   "filter": "ClientIP -> {T}",
   "group": "UserId, Operation, AppIdentity",
   "accounts": [
    "UserId"
   ]
  },
  {
   "by": "ip",
   "name": "o365_exchange_ip",
   "table": "cloud.office365.management.exchange",
   "filter": "ClientIPAddress -> {T} or ClientIP -> {T}",
   "group": "UserId, Operation",
   "accounts": [
    "UserId"
   ],
   "note": "ClientIP carries :port on admin cmdlets; ClientIPAddress is always filled."
  },
  {
   "by": "ip",
   "name": "o365_teams_ip",
   "table": "cloud.office365.management.microsoftteams",
   "filter": "ClientIP -> {T}",
   "group": "UserId, Operation",
   "accounts": [
    "UserId"
   ],
   "note": "-> also catches ::ffff:a.b.c.d. Meeting/call participant rows hold private or .x-masked client IPs."
  },
  {
   "by": "ip",
   "name": "o365_onedrive_ip",
   "table": "cloud.office365.management.onedrive",
   "filter": "ClientIP -> {T}",
   "group": "UserId, Operation",
   "accounts": [
    "UserId"
   ],
   "note": "batch-driven lag (check `devo.py lag`); back-fills repeat records: count with hllppcount(Id)."
  },
  {
   "by": "ip",
   "name": "o365_sharepoint_ip",
   "table": "cloud.office365.management.sharepoint",
   "filter": "ClientIP -> {T}",
   "group": "UserId, Operation",
   "accounts": [
    "UserId"
   ],
   "note": "batch-driven lag (check `devo.py lag`); back-fills repeat records: count with hllppcount(Id)."
  },
  {
   "by": "ip",
   "name": "o365_threatintelligence_sender_ip",
   "table": "cloud.office365.management.threatintelligence",
   "filter": "SenderIp -> {T}",
   "group": "P2Sender, Recipients, Verdict, DeliveryAction",
   "accounts": [
    "Recipients"
   ],
   "note": "Sender of flagged mail (not a client IP)."
  },
  {
   "by": "ip",
   "name": "dns_client_ip",
   "table": "dns.windows",
   "filter": "context = \"PACKET\", send_receive = \"Rcv\", query_response != \"R\", remote_ip = {T}",
   "group": "hostname, question_dot, question_type, response_code",
   "chunk": "1h",
   "parallel": 6
  },
  {
   "by": "ip",
   "name": "s1_agents_ip",
   "table": "edr.sentinelone.agent.agents",
   "filter": "lastIpToMgmt = {T} or externalIp = {T}",
   "group": "computerName, lastLoggedInUserName, lastIpToMgmt, externalIp, osName",
   "note": "lastIpToMgmt = internal IP, externalIp = public egress; agents are snapshotted periodically"
  },
  {
   "by": "ip",
   "name": "s1_threats_ip",
   "table": "edr.sentinelone.agent.threats",
   "filter": "agentDetectionInfo__agentIpV4_str -> {T} or agentDetectionInfo__externalIp = {T}",
   "group": "agentRealtimeInfo__agentComputerName, threatInfo__threatId, threatInfo__threatName"
  },
  {
   "by": "ip",
   "name": "s1_mgmt_ip",
   "table": "edr.sentinelone.management.activities",
   "filter": "dataIpAddress -> {T}",
   "group": "activityType, dataComputerName, dataUsername",
   "chunk": "10d",
   "note": "dataIpAddress is stored with quote marks: use ->"
  },
  {
   "by": "ip",
   "name": "fortinet_admin_ip",
   "table": "firewall.fortinet.event.system",
   "filter": "srcIp = {T}",
   "group": "devName, user, ui, action, status"
  },
  {
   "by": "ip",
   "name": "fortinet_ip",
   "table": "firewall.fortinet.traffic.forward",
   "filter": "srcIp = {T} or dstIp = {T} or natIp = {T}, logID = \"0000000013\"",
   "group": "devName, srcIp, dstIp, dstPort, action",
   "chunk": "30m",
   "parallel": 4
  },
  {
   "by": "ip",
   "name": "devo_web_ip",
   "table": "siem.logtrust.web.navigation",
   "filter": "srcHost = {T}",
   "group": "userEmail, section, action"
  },
  {
   "by": "ip",
   "name": "github_ent_ip",
   "table": "vcs.github.enterprise.audit",
   "filter": "actor_ipv4 = {T}",
   "group": "actor, external_identity_username, action, programmatic_access_type"
  },
  {
   "by": "ip",
   "name": "github_org_ip",
   "table": "vcs.github.organization.audit",
   "filter": "actor_ip = {T}",
   "group": "actor, external_identity_username, action",
   "note": "127.0.0.6 = scheduled workflow runs"
  },
  {
   "by": "ip",
   "name": "zscaler_ip",
   "table": "vpn.zscaler.access",
   "filter": "ClientPrivateIp = {T} or ClientPublicIp = {T} or ServerIP = {T} or ConnectorIP = {T}",
   "group": "Username, Hostname, ClientPrivateIp, ClientPublicIp, Host, ServerIP, ServerPort, ConnectorIP",
   "chunk": "1h",
   "parallel": 6
  },
  {
   "by": "ip",
   "name": "qualys_hosts_ip",
   "table": "vuln.qualys.hosts",
   "filter": "ip = {T}",
   "group": "host_id, dns_fqdn, netbios, os, tracking_method"
  },
  {
   "by": "ip",
   "name": "qualys_users_ip",
   "table": "vuln.qualys.useractivitylog",
   "filter": "user_ip = {T}",
   "group": "user_name, module, action"
  },
  {
   "by": "host",
   "name": "onepassword_device",
   "table": "auth.agilebits.onepassword.signinattempt",
   "filter": "weakhas(client__platform_name, {T})",
   "group": "target_user__email, client__app_name, client__platform_name, client__ip_address",
   "note": "client__platform_name is the device name only for the desktop apps and CLI"
  },
  {
   "by": "host",
   "name": "linux_logins_host",
   "table": "box.unix",
   "filter": "weakhas(machine, {T}), appName in {\"sshd\", \"sshd-session\", \"sudo\", \"su\"}",
   "group": "machine, appName, account, src",
   "chunk": "6h",
   "pre": "peek(message, re(\"Accepted \\\\S+ for (\\\\S+) from\"), 1) as account, peek(message, re(\" from ([0-9a-fA-F:.]+) port\"), 1) as src"
  },
  {
   "by": "host",
   "name": "win_invalid_host",
   "table": "box.win_nxlog.invalid",
   "filter": "weakhas(host, {T})",
   "select": "eventdate, host, rawMessage",
   "note": "PowerShell 4104 blocks whose JSON was truncated (very large scripts) land here instead of box.win_nxlog.powershell; low volume, so use a long --from"
  },
  {
   "by": "host",
   "name": "win_powershell_host",
   "table": "box.win_nxlog.powershell",
   "filter": "weakhas(host, {T}), EventID in {4103, 4104}",
   "group": "host, EventID, Path",
   "chunk": "3h",
   "parallel": 6
  },
  {
   "by": "host",
   "name": "win_security_host",
   "table": "box.win_nxlog.security",
   "filter": "weakhas(host, {T})",
   "group": "host, EventID",
   "chunk": "1h",
   "parallel": 6
  },
  {
   "by": "host",
   "name": "win_security_logons_to_host",
   "table": "box.win_nxlog.security",
   "filter": "weakhas(host, {T}), EventID in {4624, 4625}",
   "group": "EventID, TargetUserName, LogonType, AuthenticationPackageName",
   "chunk": "1h",
   "parallel": 6
  },
  {
   "by": "host",
   "name": "win_sysmon_host",
   "table": "box.win_nxlog.sysmon",
   "filter": "weakhas(host, {T})",
   "group": "host, EventID, User, Image",
   "chunk": "3h",
   "parallel": 6
  },
  {
   "by": "host",
   "name": "win_system_host",
   "table": "box.win_nxlog.system",
   "filter": "weakhas(host, {T})",
   "group": "host, EventID, SourceName",
   "chunk": "1h",
   "parallel": 6
  },
  {
   "by": "host",
   "name": "entra_noninteractive_device",
   "table": "cloud.azure.ad.noninteractive_user_signin",
   "filter": "weakhas(properties_deviceDetail_displayName, {T})",
   "group": "properties_deviceDetail_displayName, properties_deviceDetail_deviceId, properties_userPrincipalName, properties_ipAddress",
   "chunk": "3h",
   "parallel": 6
  },
  {
   "by": "host",
   "name": "entra_signin_device",
   "table": "cloud.azure.ad.signin",
   "filter": "weakhas(properties_deviceDetail_displayName, {T})",
   "group": "properties_deviceDetail_displayName, properties_deviceDetail_deviceId, properties_userPrincipalName, properties_ipAddress, properties_deviceDetail_trustType",
   "note": "device name = Windows NetBIOS name (uppercase) for joined devices"
  },
  {
   "by": "host",
   "name": "defender_host_inventory",
   "table": "cloud.azure.ah.device_info",
   "filter": "weakhas(device_name, {T})",
   "group": "device_id, device_name, os_platform, os_version, device_type, join_type, onboarding_status, sensor_health_state, public_ip"
  },
  {
   "by": "host",
   "name": "defender_host_logons",
   "table": "cloud.azure.ah.device_logon_event",
   "filter": "weakhas(device_name, {T})",
   "group": "action_type, logon_type, account_domain, account_name, remote_ip"
  },
  {
   "by": "host",
   "name": "defender_host_connections",
   "table": "cloud.azure.ah.device_network_event",
   "filter": "weakhas(device_name, {T}), action_type in {\"ConnectionSuccess\", \"InboundConnectionAccepted\"}",
   "group": "device_name, action_type, init_process_file_name, remote_ip, remote_port, remote_url",
   "chunk": "6h",
   "parallel": 4
  },
  {
   "by": "host",
   "name": "defender_host_processes",
   "table": "cloud.azure.ah.device_process_event",
   "filter": "weakhas(device_name, {T})",
   "group": "device_name, account_name, file_name, init_process_file_name",
   "chunk": "6h",
   "parallel": 4
  },
  {
   "by": "host",
   "name": "s1_agents_host",
   "table": "edr.sentinelone.agent.agents",
   "filter": "weakhas(computerName, {T})",
   "group": "computerName, id, uuid, lastLoggedInUserName, lastIpToMgmt, externalIp, osName, groupName"
  },
  {
   "by": "host",
   "name": "s1_threats_host",
   "table": "edr.sentinelone.agent.threats",
   "filter": "weakhas(agentRealtimeInfo__agentComputerName, {T})",
   "group": "agentRealtimeInfo__agentComputerName, threatInfo__threatId, threatInfo__threatName, threatInfo__classification"
  },
  {
   "by": "host",
   "name": "s1_mgmt_host",
   "table": "edr.sentinelone.management.activities",
   "filter": "weakhas(dataComputerName, {T})",
   "group": "dataComputerName, activityType, dataUsername",
   "chunk": "10d"
  },
  {
   "by": "host",
   "name": "zscaler_host",
   "table": "vpn.zscaler.access",
   "filter": "weakhas(Host, {T}) or weakhas(Hostname, {T})",
   "group": "Username, Hostname, Host, ServerIP, ServerPort, ConnectorIP",
   "chunk": "3h",
   "parallel": 8
  },
  {
   "by": "host",
   "name": "qualys_detections_host",
   "table": "vuln.qualys.hostdetections",
   "filter": "weakhas(dns_hostname, {T})",
   "group": "host_id, ip, detection_qid, detection_severity, detection_status",
   "note": "one row per detection per pull (several pulls a day): group, never count raw rows"
  },
  {
   "by": "host",
   "name": "qualys_hosts_host",
   "table": "vuln.qualys.hosts",
   "filter": "weakhas(dns_hostname, {T}) or weakhas(netbios, {T})",
   "group": "host_id, ip, dns_fqdn, netbios, os"
  }
 ],
 "graph": {
  "name": "graph",
  "table": "cloud.azure.ad.microsoft_graph_activity_logs",
  "filter": "properties__user_id -> {T}",
  "group": "properties__request_method, properties__request_uri, properties__response_status_code, properties__app_id, properties__ip_address_str",
  "chunk": "1h",
  "parallel": 7,
  "note": "per object id (--graph-ids); ids are stored with quote marks, hence ->"
 }
}