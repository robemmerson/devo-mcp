# Stage 1 of the credential-attack playbook (investigations.md §4): devo.py batch <this file> --vars from=3d --out-dir DIR
# Every job groups by IP + account (+ code), so distinct IPs per user and users per IP are exact when summarised client-side (snippet in the playbook).
{"name": "entra_failures", "query_file": "entra_failures.linq", "from": "{from}", "to": "now", "chunk": "6h", "limit": 0}
{"name": "entra_failures_noninteractive", "query_file": "entra_failures_noninteractive.linq", "from": "{from}", "to": "now", "chunk": "3h", "parallel": 6, "limit": 0}
{"name": "risk_detections", "query_file": "risk_detections.linq", "from": "{from}", "to": "now", "limit": 0}
{"name": "windows_4625", "query_file": "windows_4625.linq", "from": "{from}", "to": "now", "chunk": "6h", "limit": 0}
{"name": "windows_kerberos_ntlm", "query_file": "windows_kerberos_ntlm.linq", "from": "{from}", "to": "now", "chunk": "1d", "limit": 0}
{"name": "linux_ssh_failures", "query_file": "linux_ssh_failures.linq", "from": "{from}", "to": "now", "chunk": "6h", "limit": 0}
{"name": "entra_success_ip_users", "query_file": "entra_success_ip_users.linq", "from": "7d", "to": "now", "chunk": "6h", "limit": 0}
{"name": "entra_success_ip_users_noninteractive", "query_file": "entra_success_ip_users_noninteractive.linq", "from": "7d", "to": "now", "chunk": "6h", "parallel": 6, "limit": 0}
